# App
APP_ID=ainexus_prod
APP_SECRET=your_app_secret
VITE_APP_ID=ainexus_prod

# Database (use local MySQL for production)
DATABASE_URL=mysql://apimix_user:your_password@127.0.0.1:3306/apimix?ssl={"rejectUnauthorized":true}

# Kimi OAuth
KIMI_AUTH_URL=https://auth.kimi.com
KIMI_OPEN_URL=https://open.kimi.com
OWNER_UNION_ID=your_union_id

# Frontend
VITE_KIMI_AUTH_URL=https://auth.kimi.com
